#!/bin/sh /etc/rc.common

START=94
USE_PROCD=0

PROG="qca-nss-drv"

log_msg() {
	local msg="$1"
	logger -t "$PROG" "$msg"
}

cpus_to_bitmask() {
	local bitmask=0
	local range start end i

	for range in ${*//,/ }; do
		case "$range" in
			*-*)
				start="${range%-*}"
				end="${range#*-}"
				i="$start"
				while [ "$i" -le "$end" ]; do
					bitmask=$((bitmask | (1 << i)))
					i=$((i + 1))
				done
			;;
			*)
				bitmask=$((bitmask | (1 << range)))
			;;
		esac
	done

	printf '%x\n' "$bitmask"
}

set_irq_affinity() {
	local irq_name="$1"
	local cpu_list="$2"
	local occurrence="${3:-1}"
	local irq bitmask count

	bitmask="$(cpus_to_bitmask "$cpu_list")"
	count=0

	while read -r irq _rest; do
		irq="${irq%:}"
		name="$(echo "$_rest" | awk '{print $NF}')"

		[ "$name" = "$irq_name" ] || continue

		count=$((count + 1))
		[ "$count" -eq "$occurrence" ] || continue

		if [ -w "/proc/irq/$irq/smp_affinity" ]; then
			echo "$bitmask" > "/proc/irq/$irq/smp_affinity"
			$enable_log && log_msg "Pin IRQ($irq) $irq_name -> CPU(s) $cpu_list [mask $bitmask]"
		fi
		return 0
	done < /proc/interrupts

	$enable_log && log_msg "IRQ not found: $irq_name occurrence $occurrence"
	return 1
}

set_rps_for_all_rx() {
	local mask="$1"
	local flow_entries="${2:-32768}"
	local qfile

	[ -w /proc/sys/net/core/rps_sock_flow_entries ] && \
		echo "$flow_entries" > /proc/sys/net/core/rps_sock_flow_entries

	for qfile in /sys/class/net/*/queues/rx-*/rps_cpus; do
		[ -f "$qfile" ] || continue
		echo "$mask" > "$qfile" 2>/dev/null
		$enable_log && log_msg "Set RPS $qfile -> $mask"
	done

	for qfile in /sys/class/net/*/queues/rx-*/rps_flow_cnt; do
		[ -f "$qfile" ] || continue
		echo 4096 > "$qfile" 2>/dev/null
	done
}

set_xps_for_all_tx() {
	local mask="$1"
	local qfile

	for qfile in /sys/class/net/*/queues/tx-*/xps_cpus; do
		[ -f "$qfile" ] || continue
		echo "$mask" > "$qfile" 2>/dev/null
		$enable_log && log_msg "Set XPS $qfile -> $mask"
	done
}

apply_balance() {
	set_irq_affinity "nss_queue0"          "0" 1
	set_irq_affinity "nss_queue1"          "1" 1
	set_irq_affinity "nss_queue2"          "2" 1
	set_irq_affinity "nss_queue3"          "3" 1
	set_irq_affinity "nss_queue0"          "3" 2
	set_irq_affinity "nss_queue1"          "2" 2
	set_irq_affinity "nss_queue2"          "1" 2
	set_irq_affinity "nss_queue3"          "0" 2
	set_irq_affinity "nss_empty_buf_sos"   "1" 1
	set_irq_affinity "nss_empty_buf_queue" "1" 1
	set_irq_affinity "nss_empty_buf_sos"   "2" 2
	set_irq_affinity "nss_empty_buf_queue" "2" 2
	set_irq_affinity "xhci-hcd:usb1"       "2" 1
	set_irq_affinity "xhci-hcd:usb2"       "3" 1
	set_irq_affinity "xhci-hcd:usb3"       "2" 1
	set_irq_affinity "ppdu-end-interrupts-mac1" "1" 1
	set_irq_affinity "ppdu-end-interrupts-mac2" "2" 1
	set_irq_affinity "ppdu-end-interrupts-mac3" "3" 1
	set_irq_affinity "ath10k_pci"          "1-3" 1
	set_irq_affinity "ath11k_pci"          "1-3" 1
	sysctl -w dev.nss.rps.enable=1 >/dev/null 2>&1
	set_rps_for_all_rx "e" 32768
	set_xps_for_all_tx "e"
}

start() {
	local enabled

	. /lib/functions.sh

	config_load nss
	config_get enabled    general enable_rps 1
	config_get_bool elog  general enable_log 1

	[ "$elog" -eq 1 ] && enable_log=true || enable_log=false

	[ "$enabled" -eq 1 ] || {
		$enable_log && log_msg "RPS balancing disabled in UCI"
		return 0
	}

	apply_balance
}

stop() {
	:
}

restart() {
	stop
	start
}
