#!/bin/sh /etc/rc.common
# shellcheck shell=sh

START=94
USE_PROCD=0

PROG="qca-nss-drv"

log_msg() {
	local msg="$1"
	logger -t "$PROG" "$msg"
}

cpus_to_bitmask() {
	local bitmask=0
	local range start end i

	for range in ${*//,/ }; do
		case "$range" in
			*-*)
				start="${range%-*}"
				end="${range#*-}"
				i="$start"
				while [ "$i" -le "$end" ]; do
					bitmask=$((bitmask | (1 << i)))
					i=$((i + 1))
				done
			;;
			*)
				bitmask=$((bitmask | (1 << range)))
			;;
		esac
	done

	printf '%x\n' "$bitmask"
}

set_affinity() {
	local irq_name="$1"
	local affinity="$2"
	local occurrence="${3:-1}"
	local bitmask irq count name rest

	bitmask="$(cpus_to_bitmask "$affinity")"
	count=0

	while IFS= read -r line; do
		set -- $line
		irq="${1%:}"
		name="${!#}"

		[ "$name" = "$irq_name" ] || continue

		count=$((count + 1))
		[ "$count" -eq "$occurrence" ] || continue

		if [ -w "/proc/irq/$irq/smp_affinity" ]; then
			echo "$bitmask" > "/proc/irq/$irq/smp_affinity"
			$enable_log && log_msg "Pinning IRQ($irq) $irq_name to CPU(s) $affinity [mask $bitmask]"
		fi
		return 0
	done < /proc/interrupts

	$enable_log && log_msg "IRQ not found: $irq_name occurrence $occurrence"
	return 1
}

set_rps_mask() {
	local mask="$1"
	local flow_entries="${2:-32768}"
	local f

	[ -w /proc/sys/net/core/rps_sock_flow_entries ] && \
		echo "$flow_entries" > /proc/sys/net/core/rps_sock_flow_entries

	for f in /sys/class/net/*/queues/rx-*/rps_cpus; do
		[ -f "$f" ] || continue
		echo "$mask" > "$f" 2>/dev/null
		$enable_log && log_msg "RPS $(basename "$(dirname "$f")")/$(basename "$f") -> $mask"
	done

	for f in /sys/class/net/*/queues/rx-*/rps_flow_cnt; do
		[ -f "$f" ] || continue
		echo 4096 > "$f" 2>/dev/null
	done
}

set_xps_mask() {
	local mask="$1"
	local f

	for f in /sys/class/net/*/queues/tx-*/xps_cpus; do
		[ -f "$f" ] || continue
		echo "$mask" > "$f" 2>/dev/null
		$enable_log && log_msg "XPS $(basename "$(dirname "$f")")/$(basename "$f") -> $mask"
	done
}

enable_rps() {

	# NSS Core 0
	set_affinity "nss_queue0"          1 1
	set_affinity "nss_queue1"          2 1
	set_affinity "nss_queue2"          3 1
	set_affinity "nss_queue3"          1 1

	# NSS Core 1
	set_affinity "nss_queue0"          2 2
	set_affinity "nss_queue1"          3 2
	set_affinity "nss_queue2"          1 2
	set_affinity "nss_queue3"          2 2

	# Empty buffer queues, keep off CPU0
	set_affinity "nss_empty_buf_sos"   2 1
	set_affinity "nss_empty_buf_queue" 2 1
	set_affinity "nss_empty_buf_sos"   3 2
	set_affinity "nss_empty_buf_queue" 3 2

	# USB
	set_affinity "xhci-hcd:usb1"       2 1
	set_affinity "xhci-hcd:usb2"       3 1
	set_affinity "xhci-hcd:usb3"       3 1

	# Wi-Fi PPDU
	set_affinity "ppdu-end-interrupts-mac1" 1 1
	set_affinity "ppdu-end-interrupts-mac2" 3 1
	set_affinity "ppdu-end-interrupts-mac3" 2 1

	# Optional PCI style names if present
	set_affinity "ath10k_pci"          1-3 1
	set_affinity "ath11k_pci"          1-3 1

	# NSS RPS toggle
	sysctl -w dev.nss.rps.enable=1 >/dev/null 2>&1

	# Linux RPS/XPS: CPU1-3 only, leave CPU0 lighter
	set_rps_mask "e" 32768
	set_xps_mask "e"
}

start() {
	local rps_enabled

	. /lib/functions.sh

	config_load nss
	config_get      rps_enabled general enable_rps 1
	config_get_bool log_enabled general enable_log 1

	[ "$log_enabled" -eq 1 ] && enable_log=true || enable_log=false

	[ "$rps_enabled" -eq 1 ] || {
		$enable_log && log_msg "RPS balancing disabled by UCI"
		return 0
	}

	enable_rps
}

stop() {
	return 0
}

restart() {
	stop
	start
}
